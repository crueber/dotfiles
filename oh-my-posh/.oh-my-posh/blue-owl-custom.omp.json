{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#a313a8",
          "foreground": "#FFEB3B",
          "style": "plain",
          "template": "\u26a1 ",
          "type": "root"
        },
        {
          "background": "transparent",
          "foreground": "#ffffff",
          "style": "plain",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "type": "shell",
          "background": "transparent",
          "foreground": "#ffffff",
          "style": "plain",
          "template": " {{ .Name }} "
        },
        {
          "background": "#01579B",
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,#01579B>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "style": "diamond",
          "template": " {{ if .SSHSession }}⚡️ {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#0176D0",
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,#0176D0>\ue0b0</>",
          "options": {
            "folder_icon": "...",
            "folder_separator_icon": "/",
            "home_icon": "\ueb06",
            "style": "full"
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "trailing_diamond": "\ue0b0",
          "type": "path"
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": "<transparent,#9B4401>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#9B4401",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "elixir",
          "style": "diamond",
          "leading_diamond": "<transparent,#422251>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#422251",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "<transparent,#99908a>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#99908a",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "<transparent,#6CA35E>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#6CA35E",
          "foreground": "#ffffff",
          "template": "  {{ .Full }}{{ .Error }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "<transparent,#9B4401>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#9B4401",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "ruby",
          "style": "diamond",
          "leading_diamond": "<transparent,#CF020C>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#CF020C",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": "<transparent,#4063D8>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#4063D8",
          "foreground": "#ffffff",
          "template": "  {{ .Full }} "
        },
        {
          "type": "kotlin",
          "style": "diamond",
          "leading_diamond": "<transparent,#906cff>\ue0b0</>",
          "trailing_diamond": "\ue0b0",
          "background": "#906cff",
          "foreground": "#ffffff",
          "template": "  {{ .Full }}{{ .Error }} "
        },
        {
          "background": "#00C853",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFEB3B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_status": true
          },
          "style": "powerline",
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}<#FF6F00> \uf046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#29315A",
          "foreground": "#3EC669",
          "options": {
            "time_format": "15:04:05"
          },
          "leading_diamond": "\ue0ba",
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "battery",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "foreground": "#193549",
          "background": "#ffeb3b",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#9B9101{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FEF02F{{end}}",
            "{{if eq \"Full\" .State.String}}#2FA4FE{{end}}"
          ],
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }} ",
          "options": {
            "discharging_icon": "🔋 ",
            "charging_icon": " ",
            "charged_icon": " "
          }
        },
        {
          "background": "#49404f",
          "foreground": "#ffffff",
          "leading_diamond": "<transparent,#49404f>\ue0b0</>",
          "options": {
            "style": "dallas",
            "threshold": 0
          },
          "style": "diamond",
          "template": " {{ .FormattedMs }}s ",
          "trailing_diamond": "\ue0b0",
          "type": "executiontime"
        },
        {
          "background": "#910000",
          "foreground": "#ffffff",
          "trailing_diamond": "\ue0b0",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": "<transparent> \uf12a</> {{ reason .Code }} ",
          "type": "status"
        },
        {
          "type": "text",
          "template": "\u2800"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"🏚\" }} @ {{.HostName}}",
  "version": 4
}
